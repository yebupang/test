# ==============================
# 投资助手本地配置
# ==============================

# 数据库（SQLite，默认在项目根目录）
DATABASE_URL=sqlite+aiosqlite:///./investment.db

# 富途 OpenAPI 配置（需要本地运行 OpenD）
FUTU_HOST=127.0.0.1
FUTU_PORT=11111
# 富途解锁交易密码（可留空，仅查询不需要）
FUTU_TRADE_PWD=

# 盈透证券 TWS/IB Gateway 配置
IB_HOST=127.0.0.1
IB_PORT=7497        # TWS paper: 7497 | TWS live: 7496 | Gateway paper: 4002 | Gateway live: 4001
IB_CLIENT_ID=1

# Claude API（用于 AI 分析功能，Phase 3）
ANTHROPIC_API_KEY=

# 自动同步间隔（秒），0 表示不自动同步
SYNC_INTERVAL=300

# 是否启用模拟数据（开发测试用，无需连接券商）
USE_MOCK_DATA=false
